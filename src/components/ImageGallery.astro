---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";

const images = await getCollection("images");
---

<div
    id="gallery"
    class="columns-2 gap-4 sm:columns-2 sm:gap-4 md:columns-3 lg:columns-4 [&>div:not(:first-child)]:mt-4"
>
    {
        images.map(async ({ data }) => {
            const optimizedImage = await getImage({
                src: data.src,
                format: "webp",
                width: 1920,
            });

            return (
                <div
                    class="relative overflow-hidden bg-cover bg-no-repeat object-contain h-full rounded-lg"
                    data-reveal
                    data-stagger
                >
                    <a
                        href={optimizedImage.src}
                        data-pswp-width={optimizedImage.attributes.width}
                        data-pswp-height={optimizedImage.attributes.height}
                        target="_blank"
                    >
                        <Image
                            src={data.src}
                            alt={data.alt}
                            width={360}
                            decoding="async"
                            loading="lazy"
                            class="transition duration-300 ease-in-out hover:scale-110 object-contain h-full rounded-lg hover:opacity-75"
                        />
                    </a>
                </div>
            );
        })
    }
</div>

<script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import "photoswipe/style.css";

    const lightbox = new PhotoSwipeLightbox({
        gallery: "#gallery",
        children: "a",
        pswpModule: () => import("photoswipe"),
    });

    let refreshTicking = false;
    function requestRevealRefresh() {
        if (refreshTicking) return;
        refreshTicking = true;
        requestAnimationFrame(() => {
            refreshTicking = false;
            window.dispatchEvent(new Event("astro:reveal-refresh"));
        });
    }

    document.addEventListener("astro:page-load", () => {
        lightbox.init();
        requestRevealRefresh();

        document.querySelectorAll<HTMLImageElement>("#gallery img").forEach((img) => {
            if (img.complete) {
                requestRevealRefresh();
                return;
            }
            img.addEventListener("load", requestRevealRefresh, { once: true });
        });
    });
    document.addEventListener("astro:before-swap", () => lightbox.destroy());
</script>
