---
const { text } = Astro.props;
---

<div
    class="inline-block overflow-hidden pb-1 mb-8"
    data-reveal-mask
>
    <h2 class="text-3xl font-bold relative inline-block">
        <span class="relative z-10">{text}</span>
        <span
            aria-hidden="true"
            data-animate="underline"
            class="heading-underline__bar absolute left-0 right-0 -z-10 h-4 bg-mizugaki/50 dark:bg-mizugaki/70 -bottom-1"
        />
    </h2>
</div>