---
import { getCollection } from "astro:content";
import HeadingWithUnderline from "@components/HeadingWithUnderline.astro";
import Anchor from "@components/md/Anchor.astro";

const teaching = await getCollection('teaching');
---

<section class="mb-24">
    <HeadingWithUnderline text="Teaching" />
    
    <ul>
        {
            teaching.map(({data}, index) => (
                <li
                    class="mb-4 flex flex-row gap-4 items-start"
                    data-reveal
                    style={`--reveal-delay: ${Math.min(index * 70, 280)}ms`}
                >
                    <div class="min-w-[6.5rem] shrink-0 flex justify-center">
                        <span class="w-full bg-mizugaki/10 text-mizugaki dark:text-mizugaki/90 border border-mizugaki/20 px-3 py-1 rounded-full text-xs font-bold tracking-wider shadow-sm text-center">
                            {data.year}
                        </span>
                    </div>
                    
                    <div>
                        <h3>{data.role} &bull; {data.url ? <Anchor href={data.url}>{`${data.courseCode} ${data.courseTitle}`}</Anchor> : `${data.courseCode} ${data.courseTitle}`}</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">{data.institution}</p>
                    </div>
                </li>
            ))
        }
    </ul>
</section>
