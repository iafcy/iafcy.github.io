---
import { getCollection, render } from "astro:content";
import HeadingWithUnderline from "@components/HeadingWithUnderline.astro";
import mdComponent from "@components/md/components";

const news = await getCollection("news");

const newsItems = news.sort((a, b) => {
    const aTime = new Date(`${a.data.date}T00:00:00`).getTime();
    const bTime = new Date(`${b.data.date}T00:00:00`).getTime();
    return bTime - aTime;
});

const dateFormatter = new Intl.DateTimeFormat("en", {
    month: "short",
    year: "numeric",
});
---

<section class="mb-24">
    <HeadingWithUnderline text="News" />

    <div
        class="group relative rounded-2xl border border-mizugaki/40 bg-shironeri p-4 dark:bg-sumi dark:shadow-black/35 sm:p-6"
        data-news-panel
        data-at-top
        data-at-bottom
    >
        <div class="relative">
            <ul
                id="news-list"
                class="news-scroller max-h-[18rem] space-y-3 overflow-y-auto overscroll-contain pr-2 sm:max-h-[24rem] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mizugaki focus-visible:ring-offset-2 focus-visible:ring-offset-shironeri dark:focus-visible:ring-offset-sumi"
                data-lenis-prevent
                role="region"
                aria-label="News updates"
                tabindex="0"
            >
                {
                    newsItems.map(async (item, index) => {
                        const date = new Date(`${item.data.date}T00:00:00`);
                        const formattedDate = dateFormatter.format(date);
                        const { Content } = await render(item);

                        return (
                            <li
                                data-reveal
                                style={`--reveal-delay: ${Math.min(index * 70, 350)}ms`}
                            >
                                <article class="flex flex-col sm:flex-row sm:items-start gap-4">
                                    <div class="min-w-[6.5rem] shrink-0 flex justify-start sm:justify-center">
                                        <span class="sm:w-full bg-mizugaki/10 text-mizugaki dark:text-mizugaki/90 border border-mizugaki/20 px-3 py-1 rounded-full text-xs font-bold tracking-wider shadow-sm text-center">
                                            {formattedDate}
                                        </span>
                                    </div>
                                    <div class="min-w-0 [&>*]:mt-0">
                                        <Content components={mdComponent} />
                                    </div>
                                </article>
                            </li>
                        );
                    })
                }
            </ul>

            <div
                aria-hidden="true"
                class="pointer-events-none absolute left-0 right-2 top-0 z-[1] h-6 bg-gradient-to-b from-shironeri to-transparent opacity-100 transition-opacity duration-200 group-data-[at-top]:opacity-0 dark:from-sumi motion-reduce:transition-none"
            />
            <div
                aria-hidden="true"
                class="pointer-events-none absolute bottom-0 left-0 right-2 z-[1] h-6 bg-gradient-to-t from-shironeri to-transparent opacity-100 transition-opacity duration-200 group-data-[at-bottom]:opacity-0 dark:from-sumi motion-reduce:transition-none"
            />
        </div>
    </div>
</section>

<script>
    let cleanupNewsScroller: (() => void) | undefined;

    function setupNewsScroller() {
        cleanupNewsScroller?.();
        cleanupNewsScroller = undefined;

        const scroller = document.getElementById("news-list");
        const panel = scroller?.closest<HTMLElement>("[data-news-panel]");
        if (!scroller || !panel) return;

        const viewportBottom =
            scroller.getBoundingClientRect().top + scroller.clientHeight;
        let revealIndex = 0;

        scroller.querySelectorAll<HTMLElement>(":scope > li").forEach((item) => {
            const isInitiallyVisible =
                item.getBoundingClientRect().top < viewportBottom;

            if (isInitiallyVisible) {
                item.setAttribute("data-reveal", "");
                item.style.setProperty(
                    "--reveal-delay",
                    `${Math.min(revealIndex * 70, 350)}ms`
                );
                revealIndex += 1;
            } else {
                item.removeAttribute("data-reveal");
                item.style.removeProperty("--reveal-delay");
            }
        });

        const controller = new AbortController();

        const updateShadows = () => {
            const atTop = scroller.scrollTop <= 1;
            const atBottom =
                scroller.scrollTop + scroller.clientHeight >=
                scroller.scrollHeight - 1;

            panel.toggleAttribute("data-at-top", atTop);
            panel.toggleAttribute("data-at-bottom", atBottom);
        };

        scroller.addEventListener("scroll", updateShadows, {
            passive: true,
            signal: controller.signal,
        });
        window.addEventListener("resize", updateShadows, {
            passive: true,
            signal: controller.signal,
        });

        cleanupNewsScroller = () => controller.abort();

        requestAnimationFrame(updateShadows);
    }

    document.addEventListener("astro:page-load", setupNewsScroller);
</script>
