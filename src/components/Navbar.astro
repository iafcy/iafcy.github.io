---
import { ThemeToggle } from "./ThemeToggle";
import { MobileMenu } from "./MobileMenu";

const navItems = [
    {
        title: "About",
        path: "/",
    },
    {
        title: "Misc",
        path: "/misc",
    },
    {
        title: "CV",
        path: "/cv.pdf",
    },
];
---

<header
    class="fixed top-0 left-0 right-0 z-40 flex flex-col justify-center items-center h-16 bg-inherit shadow-sm dark:shadow-shironeri/15 shadow-sumi/10 overflow-hidden"
    style="view-transition-name: navbar"
>
    <div class="navbar-reveal h-full w-full flex items-center">
        <nav
            class="mx-auto max-w-[85rem] w-10/12 md:w-9/12 xl:w-7/12 flex items-center justify-between"
        >
        <a href="/"><h1 class="text-2xl font-bold">Yiu-Fai CHEUNG</h1></a>

        <div class="flex flex-row items-center gap-3">
            <ul
                class="hidden lg:flex flex-row gap-3 justify-center items-center relative"
            >
                {
                    navItems.map((item) => (
                        <li>
                            <a
                                aria-label="navigation link"
                                href={item.path}
                                class="flex py-2 lg:px-6"
                            >
                                {item.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <ThemeToggle client:load />
            <div class="lg:hidden h-[1.2rem] w-[1.2rem]">
                <MobileMenu navItems={navItems} client:load />
            </div>
        </div>
        </nav>
    </div>
</header>

<style>
    .navbar-reveal-play {
        animation: navbar-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes navbar-reveal {
        from {
            transform: translateY(-100%);
        }
        to {
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .navbar-reveal-play {
            animation: none;
        }
    }
</style>

<script is:inline>
    if (!window.__navbarRevealed) {
        window.__navbarRevealed = true;
        document
            .querySelector(".navbar-reveal")
            ?.classList.add("navbar-reveal-play");
    } else {
        document
            .querySelector(".navbar-reveal")
            ?.classList.remove("navbar-reveal-play");
    }
</script>
