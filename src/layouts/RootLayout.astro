---
import { ClientRouter } from "astro:transitions";
import "lenis/dist/lenis.css";

const { class: className } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>Yiu-Fai Cheung</title>
        
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
        <meta name="keywords" content="Large Language Models, LLM, The Chinese University of Hong Kong, CUHK, Computer Science, CS, Artificial Intelligence, AI, Yiu-Fai Cheung, Frankie Cheung, Cheung Yiu Fai, Hong Kong, HK">
        <meta name="description" content="I am a final-year student majoring in Computer Science at The Chinese University of Hong Kong, my research interest includes AI for Mental Health, AI for Social Good, the reliability and safety of Large Language Models, multi-agent systems and other applications.">
        <meta name="author" content="Yiu-Fai Cheung">
        
        <ClientRouter />

        <script is:inline>
            document.documentElement.classList.add("js");
            if (
                localStorage.theme === "dark" ||
                (!("theme" in localStorage) &&
                    window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.classList.add("dark");
            }
        </script>
    </head>
    <body
        class:list={[
            "bg-shironeri text-kuro font-sans xs:text-[16px] md:text-[18px] dark:bg-sumi dark:text-shironeri transition-all relative min-h-screen",
            className,
        ]}
    >
        <div class="scroll-progress" aria-hidden="true" />

        <slot />

        <script>
            import Lenis from "lenis";

            const lenis = new Lenis({
                autoRaf: true,
                anchors: {
                    offset: -25,
                },
                lerp: 0.125,
                duration: 1.1,
            });

            function colorTheme() {
                if (
                    localStorage.theme == "dark" ||
                    (!("theme" in localStorage) &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches)
                ) {
                    document.documentElement.classList.add("dark");
                } else {
                    document.documentElement.classList.remove("dark");
                }
            }

            let scrollAnimObserver: IntersectionObserver | null = null;

            function computePositionStagger() {
                const groups = new Map<Element, Element[]>();
                document
                    .querySelectorAll("[data-reveal][data-stagger]")
                    .forEach((el) => {
                        const parent = el.parentElement;
                        if (!parent) return;
                        if (!groups.has(parent)) groups.set(parent, []);
                        groups.get(parent)!.push(el);
                    });

                groups.forEach((items) => {
                    const parent = items[0].parentElement!;
                    const pRect = parent.getBoundingClientRect();
                    const cols: number[] = [];
                    items.forEach((el) => {
                        const r = el.getBoundingClientRect();
                        const left = Math.round(r.left - pRect.left);
                        if (!cols.includes(left)) cols.push(left);
                    });
                    cols.sort((a, b) => a - b);
                    const colOf = new Map(cols.map((c, i) => [c, i]));

                    const order = items
                        .map((el, i) => ({
                            i,
                            top: el.getBoundingClientRect().top - pRect.top,
                        }))
                        .sort((a, b) => a.top - b.top);

                    let band = -1;
                    let lastTop = -Infinity;
                    const bandOf = new Array<number>(items.length);
                    for (const { i, top } of order) {
                        if (top > lastTop + 60) band++;
                        lastTop = Math.max(lastTop, top);
                        bandOf[i] = band;
                    }

                    items.forEach((el, i) => {
                        const r = el.getBoundingClientRect();
                        const left = Math.round(r.left - pRect.left);
                        const d = bandOf[i] * 70 + (colOf.get(left) ?? 0) * 30;
                        (el as HTMLElement).style.setProperty(
                            "--reveal-delay",
                            `${Math.min(d, 480)}ms`
                        );
                    });
                });
            }

            function setupScrollAnimations() {
                if (scrollAnimObserver) scrollAnimObserver.disconnect();

                computePositionStagger();

                const targets = document.querySelectorAll(
                    "[data-animate], [data-reveal], [data-reveal-mask]"
                );
                if (!targets.length) return;

                scrollAnimObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            const el: Element = entry.target;
                            if (entry.isIntersecting) {
                                if (el.hasAttribute("data-animate")) {
                                    el.classList.remove("animate-in");
                                    void el.getBoundingClientRect();
                                    el.classList.add("animate-in");
                                }
                                if (
                                    el.hasAttribute("data-reveal") ||
                                    el.hasAttribute("data-reveal-mask")
                                ) {
                                    el.classList.add("is-visible");
                                    scrollAnimObserver?.unobserve(el);
                                }
                            } else {
                                el.classList.remove("animate-in");
                            }
                        });
                    },
                    { threshold: 0.1, rootMargin: "0px 0px -8% 0px" }
                );

                if (scrollAnimObserver) {
                    targets.forEach((el) => scrollAnimObserver && scrollAnimObserver.observe(el));
                }
            }

            /* ---- scroll progress bar ---- */
            let progressEl: HTMLElement | null = null;

            function syncGlobalNodes() {
                progressEl = document.querySelector(".scroll-progress");
            }

            function updateProgress() {
                if (!progressEl) return;
                const max =
                    document.documentElement.scrollHeight - window.innerHeight;
                const p = max > 0 ? window.scrollY / max : 0;
                progressEl.style.transform = `scaleX(${p})`;
            }

            let progressTicking = false;
            function onScroll() {
                if (progressTicking) return;
                progressTicking = true;
                requestAnimationFrame(() => {
                    updateProgress();
                    progressTicking = false;
                });
            }

            colorTheme();
            syncGlobalNodes();
            setupScrollAnimations();
            updateProgress();
            window.addEventListener("scroll", onScroll, { passive: true });

            document.addEventListener("astro:after-swap", () => {
                document.documentElement.classList.add("js");
                colorTheme();
                syncGlobalNodes();
                setupScrollAnimations();
                updateProgress();
            });

            document.addEventListener("astro:reveal-refresh", () => {
                setupScrollAnimations();
            });

            document.addEventListener(
                "click",
                (e) => {
                    if (e.defaultPrevented) return;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
                        return;
                    if (e.button !== 0) return;

                    const target = e.target as Element | null;
                    const link = target?.closest<HTMLAnchorElement>("a[href]");
                    if (!link) return;
                    if (link.target === "_blank") return;

                    let url: URL;
                    try {
                        url = new URL(link.href);
                    } catch {
                        return;
                    }
                    if (url.origin !== window.location.origin) return;

                    if (
                        url.pathname === window.location.pathname &&
                        url.search === window.location.search
                    ) {
                        e.preventDefault();
                        lenis.scrollTo(0);
                    }
                },
                true
            );
        </script>
    </body>
</html>

<style is:global>
    img {
        content-visibility: auto;
    }
</style>
