---
import RootLayout from "./RootLayout.astro";
import { fade } from "astro:transitions";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
---

<RootLayout
    class="mt-6 mb-12 mx-auto max-w-[85rem] w-10/12 md:w-9/12 xl:w-7/12"
>
    <Navbar />

    <main class="mt-24" transition:animate={fade({ duration: "0.5s" })}>
        <slot />
    </main>
    
    <Footer />
</RootLayout>

<script>
    document.addEventListener("astro:page-load", () => {
        const hero = document.querySelector("[data-hero]");
        if (!hero) return;

        const w = window as unknown as { __heroRevealedPage?: string };
        if (w.__heroRevealedPage === window.location.pathname) return;
        w.__heroRevealedPage = window.location.pathname;

        const text = hero.querySelector(".hero-text");
        if (text) {
            text.querySelectorAll<HTMLElement>(":scope > *").forEach((el, i) => {
                el.style.setProperty("--hero-delay", `${80 + i * 70}ms`);
            });
        }

        hero.classList.add("is-loaded");
    });
</script>
